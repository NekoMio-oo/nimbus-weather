<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws every pixel, so the framework theme only has to stay out of the way: no action bar,
         and a sky-blue window background so the splash screen hands over to the app without a flash. -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
